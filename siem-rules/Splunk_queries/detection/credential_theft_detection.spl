`comment("
================================================================================
Credential Theft Detection: Multiple Techniques
================================================================================
Description: Detects credential theft attempts including Mimikatz, LSASS dumps,
             SAM access, and Kerberos attacks
Author: Security Operations Team
Date: 2026-01-22
MITRE ATT&CK: T1003 (Credential Dumping)
Severity: Critical
================================================================================
")`

index=windows source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
(
    `comment("LSASS Access Detection")`
    (EventCode=10 TargetImage="*\\lsass.exe" 
     GrantedAccess IN ("0x1010", "0x1038", "0x1438", "0x143a", "0x1fffff")
     NOT SourceImage IN ("*\\csrss.exe", "*\\services.exe", "*\\MsMpEng.exe", 
                         "*\\lsass.exe", "*\\Windows Defender\\*"))
    
    OR
    
    `comment("Mimikatz Command Line Detection")`
    (EventCode=1 
     (CommandLine="*sekurlsa*" OR CommandLine="*kerberos::*" OR 
      CommandLine="*lsadump*" OR CommandLine="*privilege::debug*"))
    
    OR
    
    `comment("Credential Dumping Tool Names")`
    (EventCode=1 
     (Image="*mimikatz*" OR Image="*procdump*" OR Image="*gsecdump*" OR
      OriginalFileName="mimikatz.exe" OR OriginalFileName="procdump.exe"))
    
    OR
    
    `comment("SAM/SECURITY Hive Access")`
    (EventCode=1 
     (CommandLine="*\\SAM" OR CommandLine="*\\SECURITY" OR 
      CommandLine="*save HKLM\\SAM*" OR CommandLine="*save HKLM\\SECURITY*"))
)

| eval threat_type = case(
    match(TargetImage, "lsass\.exe") AND EventCode=10, "LSASS Memory Access",
    match(CommandLine, "sekurlsa|kerberos::|lsadump"), "Mimikatz Execution",
    match(Image, "mimikatz|procdump|gsecdump"), "Credential Dump Tool",
    match(CommandLine, "SAM|SECURITY"), "Registry Credential Access",
    1=1, "Unknown Credential Theft"
)

| eval risk_score = case(
    threat_type = "Mimikatz Execution", 95,
    threat_type = "LSASS Memory Access", 90,
    threat_type = "Credential Dump Tool", 85,
    threat_type = "Registry Credential Access", 75,
    1=1, 60
)

| stats count earliest(_time) as first_seen latest(_time) as last_seen 
        values(threat_type) as attack_types
        values(SourceImage) as source_processes
        values(CommandLine) as commands
        max(risk_score) as max_risk
        by Computer, User

| where count > 0
| sort - max_risk
| table Computer, User, attack_types, count, first_seen, last_seen, 
        source_processes, commands, max_risk
