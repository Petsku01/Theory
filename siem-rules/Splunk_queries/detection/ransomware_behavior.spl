`comment("
================================================================================
Ransomware Behavior Detection
================================================================================
Description: Comprehensive ransomware detection including file encryption,
             shadow copy deletion, and ransom note creation
Author: Security Operations Team
Date: 2026-01-22
MITRE ATT&CK: T1486 (Data Encrypted for Impact), T1490 (Inhibit System Recovery)
Severity: Critical
================================================================================
")`

| multisearch
    `comment("Shadow Copy Deletion")`
    [| search index=windows source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
       (Image="*\\vssadmin.exe" CommandLine="*delete shadows*") OR
       (Image="*\\wmic.exe" CommandLine="*shadowcopy delete*") OR
       (Image="*\\bcdedit.exe" CommandLine="*recoveryenabled*no*")
     | eval indicator_type="shadow_deletion"
     | eval risk_weight=30]
    
    `comment("Mass File Modification")`
    [| search index=windows source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=11
       (TargetFilename="*.encrypted" OR TargetFilename="*.locked" OR 
        TargetFilename="*.crypted" OR TargetFilename="*.crypt" OR
        TargetFilename="*.ransom" OR TargetFilename="*.enc")
     | bin _time span=5m
     | stats count as file_count by Computer, Image, _time
     | where file_count > 50
     | eval indicator_type="mass_encryption"
     | eval risk_weight=40]
    
    `comment("Ransom Note Creation")`
    [| search index=windows source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=11
       (TargetFilename="*readme*" OR TargetFilename="*DECRYPT*" OR
        TargetFilename="*RECOVER*" OR TargetFilename="*HOW_TO*" OR
        TargetFilename="*RANSOM*")
       (TargetFilename="*.txt" OR TargetFilename="*.html" OR TargetFilename="*.hta")
     | eval indicator_type="ransom_note"
     | eval risk_weight=20]
    
    `comment("Suspicious Encryption Commands")`
    [| search index=windows source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
       (CommandLine="*-encrypt*" OR CommandLine="*AES*" OR 
        CommandLine="*RSA*" OR CommandLine="*cipher /e*")
     | eval indicator_type="encryption_command"
     | eval risk_weight=10]

| stats sum(risk_weight) as total_risk_score
        values(indicator_type) as indicators
        count as event_count
        earliest(_time) as first_activity
        latest(_time) as last_activity
        values(Image) as processes
        by Computer

| where total_risk_score >= 40

| eval ransomware_confidence = case(
    total_risk_score >= 80, "High",
    total_risk_score >= 60, "Medium",
    1=1, "Low"
)

| eval indicator_count = mvcount(indicators)

| table Computer, ransomware_confidence, total_risk_score, indicator_count,
        indicators, event_count, first_activity, last_activity, processes

| sort - total_risk_score
